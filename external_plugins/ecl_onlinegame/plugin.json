{
  "name": "ECL-OnlineGame",
  "title": "ECL-OnlineGame",
  "version": "1.0.0-beta",
  "author": "ECLTeam",
  "description": "独立提供建房、加入、玩家管理、NAT 检测与节点设置，可选接入联机协议扩展。",
