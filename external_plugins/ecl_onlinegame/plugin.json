    {"capability": "instances.read", "required": false},
    {"capability": "accounts.read", "required": false}
  ],
  "pythonDependencies": ["easytier-pyo3==0.1.3", "httpx>=0.28.0", "psutil>=7.2.0", "pydantic>=2.0.0", "mcstatus>=12.0.0"]
}
