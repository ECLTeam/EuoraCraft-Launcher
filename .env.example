# EuoraCraft Launcher 环境变量示例。
# 复制为 .env 后填写；.env 不应提交到 Git。
# 系统环境变量优先于此文件中的同名值。

# Microsoft OAuth 应用客户端 ID。用于 Microsoft 正版账户登录。
# 可从 Azure 应用注册中获取；留空时 Microsoft 登录不可用。
MICROSOFT_CLIENT_ID=

# LittleSkin OAuth：设备代码流需要 CLIENT_ID；授权代码流还需要 CLIENT_SECRET。
# 应用需先获得 LittleSkin 白名单，普通发行版由构建工作流注入。
LITTLESKIN_CLIENT_ID=
LITTLESKIN_CLIENT_SECRET=
# 可覆盖本机回调地址；必须与 LittleSkin 应用登记的地址一致。
LITTLESKIN_REDIRECT_URI=http://127.0.0.1:34127/oauth/littleskin/callback

# MICROSOFT_CLIENT_ID 的 ECL 前缀别名，适用于部署环境注入。
# 两者同时存在时优先使用 MICROSOFT_CLIENT_ID。
ECL_MICROSOFT_CLIENT_ID=

# CurseForge API Key。用于 CurseForge 资源搜索、下载和版本查询。
# 留空时仅影响 CurseForge，Modrinth 不受影响。
# 打包版还可使用构建工作流注入的 Key；此值和系统环境变量可覆盖它。
CURSEFORGE_API_KEY=

# CURSEFORGE_API_KEY 的 ECL 前缀别名，适用于部署环境注入。
# 两者同时存在时优先使用 CURSEFORGE_API_KEY。
ECL_CURSEFORGE_API_KEY=

# 配置覆盖变量族：ECL_CONFIG_<配置分区>_<嵌套键>=<值>。
# 键名会转为小写，单个下划线表示一层嵌套；true/false、整数和小数会自动转换类型。
# 可用示例：
ECL_CONFIG_LAUNCHER_DEBUG=false
ECL_CONFIG_UI_LOCALE=zh-CN
