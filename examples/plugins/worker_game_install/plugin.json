  "entry_point": "main:Plugin",
  "permissions": [
    {
      "capability": "commands.register",
      "required": true
    },
    {
      "capability": "commands.execute",
      "required": true
    },
    {
      "capability": "game.catalog.read",
      "required": false
    },
    {
      "capability": "instances.read",
      "required": false
    },
    {
      "capability": "instances.install",
      "required": false
    }
  ]
}
