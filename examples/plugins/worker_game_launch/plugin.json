{
  "name": "worker_game_launch",
  "api_version": 2,
  "version": "1.0.0",
  "title": "获准游戏启动示例",
  "description": "仅在明确命令执行后操作用户选择的游戏资源。",
  "entry_point": "main:Plugin",
  "permissions": [
    {
      "capability": "commands.register",
      "required": true
    },
    {
      "capability": "commands.execute",
      "required": true
    },
    {
      "capability": "instances.read",
      "required": false
    },
    {
      "capability": "instances.launch",
      "required": false
    },
    {
      "capability": "instances.stop",
      "required": false
    }
  ]
}
